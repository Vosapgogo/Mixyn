# Copy to .env (git-ignored) and fill in. Never commit .env.
POSTGRES_DB=mixyn
POSTGRES_USER=mixyn
POSTGRES_PASSWORD=change-me

# Google Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash models from https://ai.google.dev/gemini-api/docs/models, tried in this order (the next ones are
# fallbacks for when the first is overloaded on the free tier)
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
