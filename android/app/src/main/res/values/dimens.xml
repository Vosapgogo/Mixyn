<?xml version="1.0" encoding="utf-8"?>
<!-- One spacing scale for the whole app. Layouts use only these values. -->
<resources>
    <!-- Spacing scale (4-based) -->
    <dimen name="space_xxs">4dp</dimen>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_s">12dp</dimen>
    <dimen name="space_m">16dp</dimen>
    <dimen name="space_l">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_xxl">48dp</dimen>

    <!-- Screen side margin (design: 24dp) -->
    <dimen name="screen_margin">@dimen/space_l</dimen>

    <!-- Corner radii -->
    <dimen name="radius_field">16dp</dimen>
    <dimen name="radius_card">24dp</dimen>
    <dimen name="radius_pill">28dp</dimen>

    <!-- Component sizes -->
    <dimen name="button_height">56dp</dimen>
    <dimen name="field_height">56dp</dimen>
    <dimen name="field_height_multiline">112dp</dimen>
    <dimen name="icon_button_size">48dp</dimen>
    <dimen name="icon_size">24dp</dimen>
    <dimen name="bottom_bar_height">72dp</dimen>
    <dimen name="bottom_bar_plus_size">56dp</dimen>
    <dimen name="avatar_size">88dp</dimen>
    <dimen name="feature_icon_size">56dp</dimen>
    <dimen name="progress_height">4dp</dimen>
    <dimen name="chip_height">44dp</dimen>
    <dimen name="chip_dot_size">10dp</dimen>
    <dimen name="swatch_size">28dp</dimen>
    <dimen name="swatch_overlap">-8dp</dimen>
    <dimen name="item_photo_height">320dp</dimen>
    <dimen name="tile_height">72dp</dimen>
    <!-- Weather tip: one piece card and the piece drawn on it -->
    <dimen name="tip_card_height">168dp</dimen>
    <dimen name="tip_card_image">88dp</dimen>
    <!-- Canvas: the gap between neighboring controls, the same in the header and in the bottom panel -->
    <dimen name="canvas_control_gap">@dimen/space_s</dimen>
    <!-- Outfit canvas: the share of the top + bottom frame that belongs to the top (36 of 78 parts) -->
    <item name="canvas_top_share" format="float" type="dimen">0.4615</item>
    <!-- Outfit canvas: how much the pieces overlap vertically, like clothes on a body -->
    <dimen name="canvas_overlap">-12dp</dimen>
    <dimen name="dash_length">4dp</dimen>
    <!-- How much the screen behind "Edit photo" is darkened: enough to show the sheet's edge and rounded
         corners, light enough to keep the photo preview clear (other sheets use the default 0.6). -->
    <item name="edit_photo_dim" format="float" type="dimen">0.28</item>
    <dimen name="sheet_list_max_height">360dp</dimen>
    <dimen name="grid_columns_gap">@dimen/space_xs</dimen>
    <dimen name="logo_tile_size">96dp</dimen>
    <dimen name="stroke">1dp</dimen>
    <dimen name="stroke_error">1.5dp</dimen>

    <!-- Type scale -->
    <dimen name="text_hero">64sp</dimen>
    <dimen name="text_display">44sp</dimen>
    <dimen name="text_title">36sp</dimen>
    <dimen name="text_logo">32sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
</resources>
