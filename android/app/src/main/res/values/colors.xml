<?xml version="1.0" encoding="utf-8"?>
<!-- Mixyn palette (from the design). Use these names everywhere; never hard-code a color in a layout. -->
<resources>
    <!-- Brand -->
    <color name="mocha">#7B6453</color>            <!-- primary buttons, splash, avatar -->
    <color name="mocha_light">#EFE8E1</color>      <!-- soft fills, selected chips -->
    <color name="ink">#1F1B17</color>              <!-- text, central +, dark buttons -->
    <color name="ink_muted">#8A837B</color>        <!-- secondary text, disabled tabs -->

    <!-- Surfaces -->
    <color name="sand_bg">#F4F1ED</color>          <!-- window background -->
    <color name="surface">#FBFAF7</color>          <!-- fields, cards, bottom bar, sheets -->
    <color name="surface_translucent">#80FBFAF7</color> <!-- the same surface, half see-through: outfit cards in the grid -->
    <color name="line">#E3DDD5</color>             <!-- field and card outlines, dividers -->
    <color name="on_dark">#FFFFFF</color>          <!-- text on mocha / ink -->
    <color name="calendar_outside">#EBE4DC</color> <!-- calendar days that belong to the month before / after -->
    <color name="splash_text">#F4EEE6</color>
    <color name="charcoal_bg">#403D38</color>       <!-- dark "processing photo" screen -->
    <color name="on_dark_muted">#C9C4BC</color>     <!-- secondary text on charcoal -->

    <!-- Illustration cards on Welcome -->
    <color name="card_beige">#E7DFD4</color>
    <color name="card_blue">#C9D2DB</color>
    <color name="stripe_brown">#8C6E5A</color>
    <color name="stripe_blue">#A3B6CA</color>
    <color name="stripe_cream">#F2ECE3</color>
    <color name="stripe_outline">#9C9A95</color>
    <color name="trouser">#3B3830</color>
    <color name="sparkle_tan">#C9A27A</color>
    <color name="card_blush">#EADFDB</color>

    <!-- Tag dots (item card → tags) -->
    <color name="tag_casual">#8FA3BF</color>
    <color name="tag_night_out">#2B2926</color>
    <color name="tag_streetwear">#A8492E</color>
    <color name="tag_date_night">#C48F86</color>
    <color name="tag_work">#6F7254</color>
    <color name="tag_favorites">#8A6C5C</color>
    <color name="tag_sports">#4F7F7A</color>
    <color name="tag_cozy">#B5AFA6</color>

    <!-- States -->
    <color name="error">#4F0005</color>            <!-- Pantone 4975C "Red Inferno": wrong input (border + message) -->
    <color name="logout">@color/error</color>      <!-- Log out row: same Red Inferno as errors -->
    <color name="remove">@color/error</color>      <!-- Remove from wardrobe: the same again -->
</resources>
