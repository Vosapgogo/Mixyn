<?xml version="1.0" encoding="utf-8"?>
<!-- Inter (OFL) is one variable font file; each weight is a variation of it. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/inter_variable" android:fontStyle="normal" android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/inter_variable" android:fontStyle="normal" android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/inter_variable" android:fontStyle="normal" android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
