<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/stroke" android:color="@color/mocha" />
            <corners android:radius="@dimen/radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/stroke" android:color="@color/line" />
            <corners android:radius="@dimen/radius_field" />
        </shape>
    </item>
</selector>
