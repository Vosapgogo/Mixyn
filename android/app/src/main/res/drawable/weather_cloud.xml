<?xml version="1.0" encoding="utf-8"?>
<!-- City for weather: a soft filled cloud, three round puffs on a flat base, to go with the sun disc.
     Each shape is its own path, so where they overlap they just paint over each other. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="@dimen/weather_icon_size"
    android:height="@dimen/weather_icon_size"
    android:viewportWidth="70"
    android:viewportHeight="70">
    <!-- The cloud itself spans x 14-76, y 20-62: moved so it fills the width, centered top to bottom -->
    <group
        android:translateX="-10"
        android:translateY="-6">
        <path
            android:fillColor="@color/weather_cloud"
            android:pathData="M14,48 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />
        <path
            android:fillColor="@color/weather_cloud"
            android:pathData="M28,38 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 Z" />
        <path
            android:fillColor="@color/weather_cloud"
            android:pathData="M52,50 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
        <path
            android:fillColor="@color/weather_cloud"
            android:pathData="M28,46 h36 v16 h-36 Z" />
    </group>
</vector>
