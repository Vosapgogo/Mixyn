<?xml version="1.0" encoding="utf-8"?>
<!-- The round tick in the corner of a choice card: filled when chosen, an empty ring when not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/mocha" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="@dimen/stroke" android:color="@color/line" />
        </shape>
    </item>
</selector>
