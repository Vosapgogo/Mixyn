<?xml version="1.0" encoding="utf-8"?>
<!-- An empty slot on the outfit canvas: the same dashed outline as "Edit photo", with a ripple when tapped. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/line">
    <item android:drawable="@drawable/bg_dashed_frame" />
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</ripple>
