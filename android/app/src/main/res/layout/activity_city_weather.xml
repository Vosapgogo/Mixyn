<?xml version="1.0" encoding="utf-8"?>
<!-- City for weather: today in the user's city on a mocha card (the city, the date, the weather picture,
     the temperature, the sky, wind, humidity and the chance of rain), tips for the day (what to wear,
     an umbrella or a raincoat when rain is coming…), the next hours as a strip of capsules, the next
     7 days, and Change city. The whole page scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The plain arrow of the item card, in the same place -->
    <ImageButton
        android:id="@+id/weather_back"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="@dimen/space_s"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:tint="@color/ink" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <!-- Today's card. Until the weather arrives it shows the city, the date and a spinner. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_weather_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/weather_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_xxs"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Mixyn.WeatherCardValue"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="@color/mocha_light" />

                <TextView
                    android:id="@+id/weather_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Mixyn.WeatherCardNote" />

                <ProgressBar
                    android:id="@+id/weather_loading"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:layout_marginBottom="@dimen/space_xxl"
                    android:indeterminateTint="@color/mocha_light" />

                <TextView
                    android:id="@+id/weather_unavailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:layout_marginBottom="@dimen/space_xl"
                    android:gravity="center"
                    android:text="@string/city_weather_unavailable"
                    android:textAppearance="@style/TextAppearance.Mixyn.WeatherCardLine"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/weather_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="@dimen/weather_card_icon_size"
                        android:layout_height="@dimen/weather_card_icon_size"
                        android:layout_marginTop="@dimen/space_s"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/weather_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Mixyn.WeatherCard" />

                    <TextView
                        android:id="@+id/weather_feel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Mixyn.WeatherCardLine" />

                    <!-- Wind, humidity and the chance of rain for the rest of today -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/weather_wind"
                            layout="@layout/item_weather_stat" />

                        <include
                            android:id="@+id/weather_humidity"
                            layout="@layout/item_weather_stat" />

                        <include
                            android:id="@+id/weather_rain"
                            layout="@layout/item_weather_stat" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tips for the day: what to wear first, then rain, wind, sun… -->
            <LinearLayout
                android:id="@+id/weather_tips_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_xs"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Mixyn.CardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather_tips_title" />

                <LinearLayout
                    android:id="@+id/weather_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- The next hours, the current one first -->
            <LinearLayout
                android:id="@+id/weather_today_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/weather_today"
                    android:textAppearance="@style/TextAppearance.Mixyn.Heading" />

                <TextView
                    android:id="@+id/weather_high_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mixyn.Body" />
            </LinearLayout>

            <!-- Runs from screen edge to screen edge, so the capsules scroll out of sight at both sides -->
            <HorizontalScrollView
                android:id="@+id/weather_hours_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin_bleed"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/screen_margin_bleed"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/weather_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/weather_week_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/weather_week"
                android:textAppearance="@style/TextAppearance.Mixyn.Heading"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/weather_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card_white"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:showDividers="middle"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weather_change_city"
                style="@style/Widget.Mixyn.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/city_weather_change"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
