<?xml version="1.0" encoding="utf-8"?>
<!-- City for weather (variant A, the learner's choice): the whole page is today's weather — the city
     and the date, the sun or a cloud, the temperature, how it feels, what to wear — and Change city. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <ImageButton
        android:id="@+id/weather_back"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/back"
        android:padding="@dimen/space_s"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:tint="@color/ink" />

    <!-- From the top, as in the sketch: city and date under the back button, then the weather -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weather_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Mixyn.Display" />

        <TextView
            android:id="@+id/weather_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.Mixyn.WeatherLine" />

        <ProgressBar
            android:id="@+id/weather_loading"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_marginTop="@dimen/space_xxl"
            android:indeterminateTint="@color/mocha" />

        <TextView
            android:id="@+id/weather_unavailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:gravity="center"
            android:text="@string/city_weather_unavailable"
            android:textAppearance="@style/TextAppearance.Mixyn.Body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/weather_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="@dimen/weather_icon_size"
                android:layout_height="@dimen/weather_icon_size"
                android:layout_marginTop="@dimen/space_xxl"
                android:importantForAccessibility="no"
                android:src="@drawable/weather_sun" />

            <TextView
                android:id="@+id/weather_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Mixyn.Weather" />

            <TextView
                android:id="@+id/weather_feel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mixyn.WeatherLine"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/weather_wear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginEnd="@dimen/space_xl"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Mixyn.WeatherLine" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/weather_change_city"
        style="@style/Widget.Mixyn.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/city_weather_change"
        app:icon="@drawable/ic_location"
        app:iconGravity="textStart" />
</LinearLayout>
