<?xml version="1.0" encoding="utf-8"?>
<!-- Add clothes: processing → "Background removed" → View item, or an error with Try again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingEnd="@dimen/space_xxl">

    <!-- Square card with the photo (the original while processing, the cutout when done) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/add_item_photo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_photo_card"
            android:clipToOutline="true"
            android:contentDescription="@string/item_photo"
            android:padding="@dimen/space_l"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/add_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:drawablePadding="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong"
        android:textColor="@color/on_dark"
        android:textFontWeight="600"
        app:drawableTint="@color/on_dark" />

    <TextView
        android:id="@+id/add_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Mixyn.Label"
        android:textColor="@color/on_dark_muted"
        android:textFontWeight="400" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/add_item_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_l"
        android:indeterminate="true"
        app:indicatorColor="@color/on_dark"
        app:trackColor="@color/ink_muted"
        app:trackCornerRadius="@dimen/progress_height"
        app:trackThickness="@dimen/progress_height" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_item_action"
        style="@style/Widget.Mixyn.Button.Soft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/add_item_cancel"
        style="@style/Widget.Mixyn.TextLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/add_item_cancel"
        android:textColor="@color/on_dark_muted"
        android:visibility="invisible" />
</LinearLayout>
