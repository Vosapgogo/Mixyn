<?xml version="1.0" encoding="utf-8"?>
<!-- Profile (design page 19): photo, name, @username · city, three tiles, the closet's palette and its
     most worn tags, then City for weather, Log out and Delete account. The pencil opens Edit profile. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_l">

        <com.mixyn.app.ui.components.MixynLogoHeader
            android:id="@+id/profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:actionDescription="@string/profile_edit"
            app:actionIcon="@drawable/ic_edit"
            app:headerTitle="@string/profile_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/profile_photo"
                android:padding="@dimen/space_l"
                android:src="@drawable/ic_profile"
                app:tint="@color/on_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mixyn.Heading" />

                <TextView
                    android:id="@+id/profile_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Mixyn.Body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout style="@style/Widget.Mixyn.StatTile">

                <TextView
                    android:id="@+id/profile_pieces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mixyn.Stat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_pieces"
                    android:textAppearance="@style/TextAppearance.Mixyn.StatLabel" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Mixyn.StatTile"
                android:layout_marginStart="@dimen/space_s">

                <TextView
                    android:id="@+id/profile_outfits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mixyn.Stat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_outfits"
                    android:textAppearance="@style/TextAppearance.Mixyn.StatLabel" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Mixyn.StatTile"
                android:layout_marginStart="@dimen/space_s">

                <TextView
                    android:id="@+id/profile_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mixyn.Stat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_days_worn"
                    android:textAppearance="@style/TextAppearance.Mixyn.StatLabel" />
            </LinearLayout>
        </LinearLayout>

        <!-- The palette and the tags appear once the closet has colors / tags -->
        <TextView
            android:id="@+id/profile_palette_title"
            style="@style/Widget.Mixyn.CardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/profile_palette"
            android:textColor="@color/ink_soft"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profile_palette"
            android:layout_width="match_parent"
            android:layout_height="@dimen/palette_height"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_palette"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profile_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/profile_city"
                style="@style/Widget.Mixyn.CardRow"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    style="@style/Widget.Mixyn.CardRowIcon"
                    android:src="@drawable/ic_location"
                    app:tint="@color/ink" />

                <TextView
                    style="@style/Widget.Mixyn.CardRowLabel"
                    android:text="@string/profile_city" />

                <TextView
                    android:id="@+id/profile_city_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mixyn.RowValue" />

                <ImageView
                    style="@style/Widget.Mixyn.CardRowIcon"
                    android:layout_marginStart="@dimen/space_xs"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View style="@style/Widget.Mixyn.CardDivider" />

            <LinearLayout
                android:id="@+id/profile_logout"
                style="@style/Widget.Mixyn.CardRow"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    style="@style/Widget.Mixyn.CardRowIcon"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/logout" />

                <TextView
                    style="@style/Widget.Mixyn.CardRowLabel"
                    android:text="@string/profile_log_out"
                    android:textColor="@color/logout" />
            </LinearLayout>

            <View style="@style/Widget.Mixyn.CardDivider" />

            <LinearLayout
                android:id="@+id/profile_delete"
                style="@style/Widget.Mixyn.CardRow"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    style="@style/Widget.Mixyn.CardRowIcon"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/remove" />

                <TextView
                    style="@style/Widget.Mixyn.CardRowLabel"
                    android:text="@string/profile_delete_account"
                    android:textColor="@color/remove" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
