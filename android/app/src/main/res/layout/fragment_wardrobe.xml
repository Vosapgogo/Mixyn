<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.mixyn.app.ui.components.MixynLogoHeader
        android:id="@+id/wardrobe_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_s"
        app:actionDescription="@string/filter_title"
        app:actionIcon="@drawable/ic_menu"
        app:headerTitle="@string/app_name"
        app:secondActionDescription="@string/search_open"
        app:secondActionIcon="@drawable/ic_search" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/wardrobe_tabs"
        style="@style/Widget.Mixyn.Tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke"
        android:background="@color/line" />

    <!-- Opened by the magnifier in the header; searches the tab that is showing -->
    <com.mixyn.app.ui.components.MixynTextField
        android:id="@+id/wardrobe_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/screen_margin"
        android:visibility="gone"
        app:fieldType="search"
        app:hint="@string/search_hint" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/wardrobe_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
