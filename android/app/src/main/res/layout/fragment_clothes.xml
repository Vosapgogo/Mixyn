<?xml version="1.0" encoding="utf-8"?>
<!-- Clothes tab: the item grid, the empty-closet state when there are no items, or "nothing matches"
     when the filters or the search leave nothing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/clothes_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_l"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/clothes_loading"
        android:layout_width="@dimen/space_xl"
        android:layout_height="@dimen/space_xl"
        android:layout_gravity="center"
        android:indeterminateTint="@color/mocha" />

    <TextView
        android:id="@+id/clothes_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/screen_margin"
        android:textAppearance="@style/TextAppearance.Mixyn.Body"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/clothes_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/empty_closet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/empty_closet_title"
                android:textAppearance="@style/TextAppearance.Mixyn.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/empty_closet_body"
                android:textAppearance="@style/TextAppearance.Mixyn.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clothes_add"
                style="@style/Widget.Mixyn.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_add_clothes"
                app:icon="@drawable/ic_plus" />
        </LinearLayout>
    </ScrollView>

    <!-- The closet has pieces, but none fits the filters or the search -->
    <LinearLayout
        android:id="@+id/clothes_no_match"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_match_title"
            android:textAppearance="@style/TextAppearance.Mixyn.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/no_match_body"
            android:textAppearance="@style/TextAppearance.Mixyn.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clothes_clear_filters"
            style="@style/Widget.Mixyn.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/no_match_clear" />
    </LinearLayout>
</FrameLayout>
