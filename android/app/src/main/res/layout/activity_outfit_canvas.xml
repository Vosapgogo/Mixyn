<?xml version="1.0" encoding="utf-8"?>
<!-- Create outfit: the pieces stacked like a silhouette (top, bottom, shoes) with optional layers over
     them (outerwear, a bag, accessories). Every slot and layer is its own horizontal pager, so swiping
     one piece never moves the others. A slot the closet has nothing for shows a dashed placeholder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header: back, the weather in the user's city, and Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/canvas_back"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/space_s"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The filter: only pieces of the chosen colors and types in the carousels. The dot says it is on. -->
        <FrameLayout
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginEnd="@dimen/space_xxs">

            <ImageButton
                android:id="@+id/canvas_filter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filter_title"
                android:padding="@dimen/space_s"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                app:tint="@color/ink" />

            <View
                android:id="@+id/canvas_filter_badge"
                android:layout_width="@dimen/chip_dot_size"
                android:layout_height="@dimen/chip_dot_size"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@drawable/bg_badge_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Hidden until the weather arrives (and stays hidden if it can't be loaded).
             Tapping it asks whether to add what the weather calls for. -->
        <TextView
            android:id="@+id/canvas_weather"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_pill_surface"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/screen_margin"
            android:textAppearance="@style/TextAppearance.Mixyn.Label"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_cloud"
            app:drawableTint="@color/ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/canvas_next"
            style="@style/Widget.Mixyn.Button.Dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/canvas_control_gap"
            android:minHeight="@dimen/icon_button_size"
            android:text="@string/canvas_next"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/canvas_slots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xxl"
            android:paddingBottom="@dimen/space_m">

            <!-- The body of the outfit: top and bottom share one frame with two optional layers. In drawing
                 order: bottom, the piece worn under the top (it reaches a little above and below the top),
                 the top, and the outerwear over everything: a jacket covers the top, a long coat reaches
                 down over the bottom as well. The activity lifts the bottom over the top again while
                 nothing is worn under it. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="78"
                android:clipChildren="false">

                <!-- Where the top's part of the frame ends and the bottom's begins -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/canvas_slot_split"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="@dimen/canvas_top_share" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/canvas_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/canvas_overlap"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/canvas_slot_split" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/canvas_under"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    android:contentDescription="@string/canvas_under"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Not clipped: a dress in the top's slot reaches down over the bottom's part of the frame -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/canvas_top"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    app:layout_constraintBottom_toTopOf="@id/canvas_slot_split"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/canvas_outerwear"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:contentDescription="@string/category_outerwear"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Shown instead of the top or the bottom while the closet has none: tapping one opens
                     Add clothes. A piece's width, in that piece's part of the frame. -->
                <com.mixyn.app.ui.canvas.SlotPlaceholderView
                    android:id="@+id/canvas_top_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/canvas_missing_top"
                    android:visibility="gone"
                    app:noMatchText="@string/canvas_no_match_top"
                    app:layout_constraintBottom_toTopOf="@id/canvas_slot_split"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="@dimen/canvas_piece_share" />

                <com.mixyn.app.ui.canvas.SlotPlaceholderView
                    android:id="@+id/canvas_bottom_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/canvas_missing_bottom"
                    android:visibility="gone"
                    app:noMatchText="@string/canvas_no_match_bottom"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/canvas_slot_split"
                    app:layout_constraintWidth_percent="@dimen/canvas_piece_share" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="22">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/canvas_shoes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.mixyn.app.ui.canvas.SlotPlaceholderView
                    android:id="@+id/canvas_shoes_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/canvas_missing_shoes"
                    android:visibility="gone"
                    app:noMatchText="@string/canvas_no_match_shoes"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="@dimen/canvas_shoes_share" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- The bag and the accessories. Each pager is hidden until its layer is put on; the activity
             gives every one its place on the outfit (head, neck, waist, by the hand…). Later ones are on top. -->
        <FrameLayout
            android:id="@+id/canvas_layers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/canvas_waist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/canvas_neck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/canvas_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/canvas_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/canvas_hands"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/canvas_bag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/category_bag"
                android:visibility="gone" />
        </FrameLayout>

        <!-- While one layer is being chosen: what to do, where the stylist button normally sits -->
        <TextView
            android:id="@+id/canvas_focus_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@drawable/bg_pill_surface"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Mixyn.Label"
            android:visibility="gone" />

        <!-- Ask AI: a round button at the side of the canvas; a spinner replaces the icon while styling -->
        <FrameLayout
            android:id="@+id/canvas_ask_ai_holder"
            android:layout_width="@dimen/bottom_bar_plus_size"
            android:layout_height="@dimen/bottom_bar_plus_size"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/space_m">

            <ImageButton
                android:id="@+id/canvas_ask_ai"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_plus_button"
                android:contentDescription="@string/canvas_ask_ai"
                android:enabled="false"
                android:padding="@dimen/space_m"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/on_dark" />

            <ProgressBar
                android:id="@+id/canvas_styling"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:indeterminateTint="@color/on_dark"
                android:visibility="gone" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/canvas_loading"
            android:layout_width="@dimen/space_xl"
            android:layout_height="@dimen/space_xl"
            android:layout_gravity="center"
            android:indeterminateTint="@color/mocha" />

        <LinearLayout
            android:id="@+id/canvas_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin"
            android:visibility="gone">

            <TextView
                android:id="@+id/canvas_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/canvas_empty_title"
                android:textAppearance="@style/TextAppearance.Mixyn.Title" />

            <TextView
                android:id="@+id/canvas_empty_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/canvas_empty_body"
                android:textAppearance="@style/TextAppearance.Mixyn.Body" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom panel: four equal tiles for the optional layers. While one of them is being chosen
         the tiles give way to Remove / Done, and the rest of the outfit is locked. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m">

        <LinearLayout
            android:id="@+id/canvas_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/canvas_under_button"
                style="@style/Widget.Mixyn.Button.Tile.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_height"
                android:layout_weight="1"
                android:text="@string/canvas_under"
                app:icon="@drawable/ic_shirt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/canvas_outerwear_button"
                style="@style/Widget.Mixyn.Button.Tile.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_height"
                android:layout_marginStart="@dimen/canvas_control_gap"
                android:layout_weight="1"
                android:text="@string/canvas_outerwear"
                app:icon="@drawable/ic_jacket" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/canvas_bag_button"
                style="@style/Widget.Mixyn.Button.Tile.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_height"
                android:layout_marginStart="@dimen/canvas_control_gap"
                android:layout_weight="1"
                android:text="@string/canvas_bag"
                app:icon="@drawable/ic_bag" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/canvas_accessory_button"
                style="@style/Widget.Mixyn.Button.Tile.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_height"
                android:layout_marginStart="@dimen/canvas_control_gap"
                android:layout_weight="1"
                android:text="@string/canvas_accessories"
                app:icon="@drawable/ic_accessory" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/canvas_focus_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/canvas_focus_remove"
                style="@style/Widget.Mixyn.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_height"
                android:layout_weight="1"
                android:text="@string/canvas_focus_remove"
                app:cornerRadius="@dimen/radius_field" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/canvas_focus_done"
                style="@style/Widget.Mixyn.Button.Dark"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_height"
                android:layout_marginStart="@dimen/canvas_control_gap"
                android:layout_weight="2"
                android:text="@string/action_done"
                app:cornerRadius="@dimen/radius_field"
                app:icon="@drawable/ic_check" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
