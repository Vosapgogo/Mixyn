<?xml version="1.0" encoding="utf-8"?>
<!-- One screen, two modes: Create account (name, email, password, city) and Log in (email, password). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_l">

        <com.mixyn.app.ui.components.MixynBackHeader
            android:id="@+id/auth_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.mixyn.app.ui.components.MixynTextField
            android:id="@+id/auth_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:fieldType="name"
            app:hint="@string/field_name_hint"
            app:label="@string/field_name" />

        <com.mixyn.app.ui.components.MixynTextField
            android:id="@+id/auth_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:fieldType="email"
            app:hint="@string/field_email_hint"
            app:label="@string/field_email" />

        <com.mixyn.app.ui.components.MixynTextField
            android:id="@+id/auth_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:fieldType="password"
            app:label="@string/field_password" />

        <com.mixyn.app.ui.components.MixynTextField
            android:id="@+id/auth_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:fieldType="text"
            app:hint="@string/field_city_hint"
            app:label="@string/field_city" />

        <TextView
            android:id="@+id/auth_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:textAppearance="@style/TextAppearance.Mixyn.Error"
            android:visibility="gone" />

        <TextView
            android:id="@+id/auth_error_action"
            style="@style/Widget.Mixyn.TextLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_email_taken_action"
            android:visibility="gone" />

        <!-- Same gap above the button on Create account and Log in (design: ~48dp) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_submit"
                style="@style/Widget.Mixyn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/auth_progress"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:elevation="@dimen/space_xs"
                android:indeterminateTint="@color/on_dark"
                android:visibility="gone" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_l" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/auth_switch_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.Mixyn.Body" />

            <TextView
                android:id="@+id/auth_switch"
                style="@style/Widget.Mixyn.TextLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
