<?xml version="1.0" encoding="utf-8"?>
<!-- City for weather: one of the three values at the bottom of today's card (wind, humidity, chance of
     rain): its icon, the value and what it is. Each takes a third of the card's width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/stat_icon"
        android:layout_width="@dimen/weather_stat_icon_size"
        android:layout_height="@dimen/weather_stat_icon_size"
        android:importantForAccessibility="no"
        app:tint="@color/mocha_light" />

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:textAppearance="@style/TextAppearance.Mixyn.WeatherCardValue" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Mixyn.WeatherCardNote" />
</LinearLayout>
