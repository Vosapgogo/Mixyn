<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_l">

    <!-- Illustration: cards drawn in one vector; the chip is real text placed on top of it -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m">

        <ImageView
            android:id="@+id/welcome_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:src="@drawable/welcome_illustration"
            app:layout_constraintDimensionRatio="944:920"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Chip sits over the sneaker toe: right edge at 97% across, ~85% down the art -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/welcome_chip_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.97" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/welcome_chip_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.848" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_dark"
            android:drawablePadding="@dimen/space_xs"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/welcome_chip"
            android:textAppearance="@style/TextAppearance.Mixyn.Label"
            android:textColor="@color/on_dark"
            app:drawableStartCompat="@drawable/ic_sparkle"
            app:drawableTint="@color/on_dark"
            app:layout_constraintBottom_toBottomOf="@id/welcome_chip_center"
            app:layout_constraintEnd_toEndOf="@id/welcome_chip_end"
            app:layout_constraintTop_toTopOf="@id/welcome_chip_center" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/welcome_title"
        android:textAppearance="@style/TextAppearance.Mixyn.Display" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/welcome_body"
        android:textAppearance="@style/TextAppearance.Mixyn.Body" />

    <!-- Pushes the buttons to the bottom of the screen -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_create"
        style="@style/Widget.Mixyn.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_create_account" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_login"
        style="@style/Widget.Mixyn.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/action_have_account" />
</LinearLayout>
