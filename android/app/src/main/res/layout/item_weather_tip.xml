<?xml version="1.0" encoding="utf-8"?>
<!-- City for weather: one tip for the day (what to wear, take an umbrella…), with an icon for what it is
     about. The icon is its own view, not a compound drawable: that one would sit in the middle of a tip
     two lines long, this one stays by the first line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:id="@+id/tip_icon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:importantForAccessibility="no"
        app:tint="@color/mocha" />

    <TextView
        android:id="@+id/tip_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Mixyn.WeatherTip" />
</LinearLayout>
