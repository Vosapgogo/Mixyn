<?xml version="1.0" encoding="utf-8"?>
<!-- After logging out or deleting the account: a goodbye, and the way back to the start. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <ImageView
        android:layout_width="@dimen/logo_tile_size"
        android:layout_height="@dimen/logo_tile_size"
        android:background="@drawable/bg_avatar"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_l"
        android:src="@drawable/ic_hanger"
        app:tint="@color/on_dark" />

    <TextView
        android:id="@+id/goodbye_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Mixyn.Title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:text="@string/goodbye_body"
        android:textAppearance="@style/TextAppearance.Mixyn.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/goodbye_start"
        style="@style/Widget.Mixyn.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/goodbye_action"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="textEnd" />
</LinearLayout>
