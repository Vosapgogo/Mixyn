<?xml version="1.0" encoding="utf-8"?>
<!-- Shown once, right after Create account (design page 4a). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_l">

        <!-- Arch art with the "Account created" chip sitting on its bottom edge -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l">

            <ImageView
                android:id="@+id/created_art"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:src="@drawable/account_created_art"
                app:layout_constraintDimensionRatio="640:700"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_dark"
                android:drawablePadding="@dimen/space_xs"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_s"
                android:text="@string/account_created_chip"
                android:textAppearance="@style/TextAppearance.Mixyn.Label"
                android:textColor="@color/on_dark"
                app:drawableStartCompat="@drawable/ic_check"
                app:drawableTint="@color/on_dark"
                app:layout_constraintBottom_toBottomOf="@id/created_art"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/created_art" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/created_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Mixyn.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/account_created_body"
            android:textAppearance="@style/TextAppearance.Mixyn.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    style="@style/Widget.Mixyn.FeatureIcon"
                    android:background="@drawable/bg_feature_beige"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/feature_snap"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_snap_hint"
                    android:textAppearance="@style/TextAppearance.Mixyn.Label"
                    android:textColor="@color/ink_muted"
                    android:textFontWeight="400" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    style="@style/Widget.Mixyn.FeatureIcon"
                    android:background="@drawable/bg_feature_blue"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shuffle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/feature_mix"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_mix_hint"
                    android:textAppearance="@style/TextAppearance.Mixyn.Label"
                    android:textColor="@color/ink_muted"
                    android:textFontWeight="400" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    style="@style/Widget.Mixyn.FeatureIcon"
                    android:background="@drawable/bg_feature_blush"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sparkle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/feature_relax"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_relax_hint"
                    android:textAppearance="@style/TextAppearance.Mixyn.Label"
                    android:textColor="@color/ink_muted"
                    android:textFontWeight="400" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_l" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/created_go"
            style="@style/Widget.Mixyn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_lets_go"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />

        <TextView
            android:id="@+id/created_later"
            style="@style/Widget.Mixyn.TextLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/action_look_around"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
