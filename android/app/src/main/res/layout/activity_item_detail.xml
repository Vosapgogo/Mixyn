<?xml version="1.0" encoding="utf-8"?>
<!-- Item card: photo, name + Edit photo, then type / tags / color / season rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_l">

        <ImageButton
            android:id="@+id/item_back"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginTop="@dimen/space_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/space_s"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The frame clips the photo, so "Size" can enlarge it without covering the screen -->
            <FrameLayout
                android:id="@+id/item_photo_frame"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_photo_height"
                android:layout_marginStart="@dimen/space_xxl"
                android:layout_marginEnd="@dimen/space_xxl"
                android:clipChildren="true"
                android:clipToOutline="true"
                android:padding="@dimen/space_xs">

                <ImageView
                    android:id="@+id/item_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/item_photo"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:id="@+id/item_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Mixyn.Logo" />

            <ImageButton
                android:id="@+id/item_name_edit"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/item_edit_name"
                android:padding="@dimen/space_s"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit"
                app:tint="@color/ink_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_edit_photo"
                style="@style/Widget.Mixyn.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/item_edit_photo"
                app:icon="@drawable/ic_image" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/item_row_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_s">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_list"
                    app:tint="@color/ink_muted" />

                <TextView
                    android:id="@+id/item_type_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:id="@+id/item_type_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mixyn.RowValue" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/item_row_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_s">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tag"
                    app:tint="@color/ink_muted" />

                <TextView
                    android:id="@+id/item_tags_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:id="@+id/item_tags_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mixyn.RowValue" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/item_row_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_s">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_drop"
                    app:tint="@color/ink_muted" />

                <!-- One overlapping dot per chosen color, filled in by the screen -->
                <LinearLayout
                    android:id="@+id/item_color_swatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/item_color_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:id="@+id/item_color_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mixyn.RowValue" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/item_row_season"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_s">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sun"
                    app:tint="@color/ink_muted" />

                <TextView
                    android:id="@+id/item_season_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <TextView
                    android:id="@+id/item_season_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mixyn.RowValue" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />
            </LinearLayout>

            <!-- Open or closed front: only for tops and outerwear (the activity hides it for the rest) -->
            <View
                android:id="@+id/item_front_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/item_row_front"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/button_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_s">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_jacket"
                    app:tint="@color/ink_muted" />

                <TextView
                    android:id="@+id/item_front_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mixyn.BodyStrong" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <com.mixyn.app.ui.components.MixynBottomBar
        android:id="@+id/item_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height" />
</LinearLayout>
