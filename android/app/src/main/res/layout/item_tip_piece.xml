<?xml version="1.0" encoding="utf-8"?>
<!-- One piece the weather tip offers: what it is, a tick, the user's own piece and its name. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="@dimen/tip_card_height"
    android:layout_weight="1"
    android:background="@drawable/bg_choice_card"
    android:padding="@dimen/space_s">

    <TextView
        android:id="@+id/tip_piece_kind"
        style="@style/Widget.Mixyn.CardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start" />

    <ImageView
        android:id="@+id/tip_piece_check"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_check"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_xxs"
        android:src="@drawable/ic_check"
        app:tint="@color/check_mark" />

    <ImageView
        android:id="@+id/tip_piece_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tip_card_image"
        android:layout_gravity="center"
        android:contentDescription="@string/item_photo"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tip_piece_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Mixyn.Label" />
</FrameLayout>
