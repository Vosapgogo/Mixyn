<?xml version="1.0" encoding="utf-8"?>
<!-- One saved outfit in the Outfits grid: its picture on a white card, 4:5 like on the outfit's own card. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_xs">

    <ImageView
        android:id="@+id/outfit_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card"
        android:contentDescription="@string/outfit_picture"
        android:foreground="?attr/selectableItemBackground"
        android:padding="@dimen/space_s"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
