<?xml version="1.0" encoding="utf-8"?>
<!-- "Chilly out. Want a layer?": the weather, a card for every piece on offer (all ticked to begin
     with), and add / not now. Scrolls on small screens. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_l">

        <View
            android:layout_width="@dimen/space_xxl"
            android:layout_height="@dimen/space_xxs"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/weather_tip_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Mixyn.Label"
            app:drawableTint="@color/ink" />

        <TextView
            android:id="@+id/weather_tip_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Mixyn.Logo" />

        <TextView
            android:id="@+id/weather_tip_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Mixyn.Body" />

        <!-- Rows of two cards, filled in by WeatherTipSheet -->
        <LinearLayout
            android:id="@+id/weather_tip_pieces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weather_tip_add"
            style="@style/Widget.Mixyn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/weather_tip_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weather_tip_skip"
            style="@style/Widget.Mixyn.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/weather_tip_skip" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
